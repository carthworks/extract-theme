# ==============================================================================
# ExtractTheme Studio — Persistent Object Storage Configuration
# ==============================================================================

# --- Option A: Cloudflare R2 (Recommended for zero-egress cost) ---
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
# S3_BUCKET_NAME=extract-theme-storage
# S3_REGION_NAME=auto

# --- Option B: AWS S3 ---
# AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
# AWS_S3_BUCKET_NAME=<YOUR_AWS_S3_BUCKET_NAME>
# AWS_REGION=us-east-1

# Optional prefix within the bucket (default: themes)
# S3_KEY_PREFIX=themes
